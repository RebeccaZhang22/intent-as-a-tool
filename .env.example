# Copy to .env and fill in your own values. Never commit the real .env.

# OpenAI-compatible API for the LLM-as-judge classifiers.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# vLLM OpenAI-compatible server hosting the behavior model under study.
VLLM_API_KEY=EMPTY
VLLM_SERVER=http://localhost:8000/v1
